<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ViewProductsController">
   <children>
      <Rectangle fill="#0e4c92" height="71.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="600.0" />
      <Label layoutX="219.0" layoutY="17.0" text="View Products" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TableView fx:id="tblProducts" layoutX="14.0" layoutY="177.0" prefHeight="167.0" prefWidth="571.0">
        <columns>
          <TableColumn fx:id="colCode" prefWidth="70.0" text="code" />
            <TableColumn fx:id="colDescription" prefWidth="182.00003051757812" text="description" />
            <TableColumn fx:id="colUnitPrice" prefWidth="99.33331298828125" text="unit_price" />
            <TableColumn fx:id="colQtyInStock" prefWidth="124.6666259765625" text="qty_in_stock" />
            <TableColumn fx:id="colSupplierId" prefWidth="94.6666259765625" text="sup_id" />
        </columns>
      </TableView>
      <Button fx:id="btnReload" layoutX="275.0" layoutY="357.0" mnemonicParsing="false" onAction="#btnReloadOnAction" style="-fx-background-color: #061E3A;" text="Reload" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnLadies" layoutX="161.0" layoutY="86.0" mnemonicParsing="false" onAction="#btnLoadLadiesOnAction" style="-fx-background-color: #061E3A;" text="Ladies" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnGents" layoutX="277.0" layoutY="86.0" mnemonicParsing="false" onAction="#btnLoadGentsOnAction" style="-fx-background-color: #061E3A;" text="Gents" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnKids" layoutX="391.0" layoutY="86.0" mnemonicParsing="false" onAction="#btnLoadKidsOnAction" style="-fx-background-color: #061E3A;" text="Kids" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <ComboBox fx:id="cmbSize" layoutX="228.0" layoutY="130.0" onAction="#cmbLoadSizesOnAction" prefWidth="150.0" promptText="size" />
   </children>
</AnchorPane>
