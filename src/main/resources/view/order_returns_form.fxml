<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.order.OrderReturnsFormController">
   <children>
      <Rectangle fill="#0e4c92" height="71.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="600.0" />
      <Label layoutX="188.0" layoutY="18.0" text="Order Returns Form" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <ComboBox fx:id="cmbOrderId" layoutX="38.0" layoutY="96.0" onAction="#cmbShowOrderIdOnAction" prefWidth="150.0" promptText="order id" />
      <ComboBox fx:id="cmbProductCode" layoutX="239.0" layoutY="96.0" onAction="#cmbShowProductCodeOnAction" prefWidth="150.0" promptText="product code" />
      <JFXTextField fx:id="txtQuantity" disable="true" layoutX="433.0" layoutY="96.0" promptText="quantity" />
      <JFXTextField fx:id="txtOrderDate" disable="true" layoutX="247.0" layoutY="154.0" promptText="order date" />
      <TableView fx:id="tblOrderReturns" layoutX="48.0" layoutY="200.0" prefHeight="149.0" prefWidth="504.0">
        <columns>
          <TableColumn fx:id="colOrderId" prefWidth="159.33328247070312" text="Order id" />
          <TableColumn fx:id="colProdCode" prefWidth="174.66668701171875" text="Product code" />
            <TableColumn fx:id="colQuantity" prefWidth="169.33331298828125" text="Quantity" />
        </columns>
      </TableView>
      <Button fx:id="btnReturn" layoutX="465.0" layoutY="360.0" mnemonicParsing="false" onAction="#btnReturnOnAction" style="-fx-background-color: #061E3A;" text="Return" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
