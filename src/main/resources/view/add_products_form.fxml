<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddProductsFormController">
   <children>
      <Rectangle fill="#0e4c92" height="71.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="600.0" />
      <Label layoutX="191.0" layoutY="18.0" text="Add Products Form" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <JFXTextField fx:id="txtDescription" layoutX="35.0" layoutY="94.0" promptText="description" />
      <ComboBox fx:id="cmbCategory" layoutX="216.0" layoutY="94.0" onAction="#cmbSelectCategoryOnAction" prefWidth="150.0" promptText="category" />
      <ComboBox fx:id="cmbSize" layoutX="415.0" layoutY="94.0" onAction="#cmbSelectSizeOnAction" prefWidth="150.0" promptText="size" />
      <JFXTextField fx:id="txtUnitPrice" layoutX="35.0" layoutY="166.0" promptText="unit price" />
      <JFXTextField fx:id="txtQuantity" layoutX="224.0" layoutY="166.0" promptText="quantity" />
      <ComboBox fx:id="cmbSupplierId" layoutX="415.0" layoutY="166.0" onAction="#cmbSelectSupplierIdOnAction" prefWidth="150.0" promptText="supplier id" />
      <Button fx:id="btnAdd" layoutX="190.0" layoutY="269.0" mnemonicParsing="false" onAction="#btnAddOnAction" style="-fx-background-color: #061E3A;" text="Add" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnSearch" layoutX="260.0" layoutY="269.0" mnemonicParsing="false" onAction="#btnSearchOnAction" style="-fx-background-color: #061E3A;" text="Search" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnUpdate" layoutX="345.0" layoutY="268.0" mnemonicParsing="false" onAction="#btnUpdateOnAction" style="-fx-background-color: #061E3A;" text="Update" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnDelete" layoutX="434.0" layoutY="268.0" mnemonicParsing="false" onAction="#btnDeleteOnAction" style="-fx-background-color: #061E3A;" text="Delete" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
